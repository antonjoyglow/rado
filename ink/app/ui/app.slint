// Sizes are logical pixels: on the Era Color one is 3.48 physical pixels (300 dpi times its 1.16 scale), so the
// screen is about 363 by 483. The page is a notifier read from across the desk: the numbers first, then one line per
// thing waiting on me. Colour is only in the Urgent tag.
import "fonts/AtkinsonHyperlegibleNext.ttf";
import "fonts/JetBrainsMono.ttf";
import { Palette } from "std-widgets.slint";

export enum Tier { low, normal, urgent }

export struct Item {
    title: string,
    age: string,
    tier: Tier,
    new: bool,
    re-review: bool,
    yours: bool,
    draft: bool,
}

export enum Mode { setup, waiting, list }

component Tag inherits Rectangle {
    in property <string> text;
    in property <color> fill: transparent;
    in property <color> ink: black;
    in property <bool> outlined;
    height: 13px;
    border-radius: 6.5px;
    background: fill;
    border-width: outlined ? 1px : 0;
    border-color: black;
    HorizontalLayout {
        padding-left: 5px;
        padding-right: 5px;
        Text {
            text: root.text;
            color: root.ink;
            font-size: 8px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
}

component Button inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    min-width: 30px;
    height: 22px;
    border-radius: 11px;
    border-width: 1px;
    border-color: enabled ? black : #aaa;
    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        Text {
            text: root.text;
            color: root.enabled ? black : #aaa;
            font-size: 9px;
            font-weight: 700;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
    TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component ItemLine inherits Rectangle {
    in property <Item> item;
    height: 27px;
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: #ccc;
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 4px;
        // Kaleido colour is faint, so the fill is dark and saturated and the word alone says it.
        if item.tier == Tier.urgent: VerticalLayout {
            alignment: center;
            Tag { text: "Urgent"; fill: #a0001c; ink: white; }
        }
        Text {
            text: item.title;
            horizontal-stretch: 1;
            color: item.tier == Tier.low ? #555 : black;
            font-size: 10px;
            font-weight: item.new || item.tier == Tier.urgent ? 700 : 400;
            vertical-alignment: center;
            overflow: elide;
        }
        if item.new: VerticalLayout {
            alignment: center;
            Tag { text: "NEW"; fill: black; ink: white; }
        }
        if item.re-review: VerticalLayout {
            alignment: center;
            Tag { text: "Re-review"; outlined: true; }
        }
        if item.yours: VerticalLayout {
            alignment: center;
            Tag { text: "Yours"; outlined: true; }
        }
        if item.draft: VerticalLayout {
            alignment: center;
            Tag { text: "Draft"; fill: #d0d0d0; }
        }
        Text {
            text: item.age;
            width: 22px;
            font-family: "JetBrains Mono";
            font-size: 9px;
            color: #444;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

export component AppWindow inherits Window {
    in property <Mode> mode;
    /// The setup problem, or what the app is doing before the first list.
    in property <string> message;
    in property <string> config-path;
    in property <string> workspace;
    in property <int> reviews;
    in property <int> mine;
    in property <string> summary;
    in property <bool> has-new;
    in property <string> updated;
    in property <[string]> banners;
    in property <[Item]> items;
    in property <int> page;
    in property <int> pages;
    callback acknowledge();
    callback turn-page(bool);
    callback exit();

    preferred-width: 363px;
    preferred-height: 483px;
    background: white;
    default-font-family: "Atkinson Hyperlegible Next";

    // Text defaults to the palette's colour, which a desktop in dark mode makes white.
    init => { Palette.color-scheme = ColorScheme.light; }

    forward-focus: keys;
    // The page buttons arrive as Left and Right (inkview-slint's mapping of Prev and Next).
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.LeftArrow || event.text == Key.PageUp) {
                root.turn-page(false);
                return accept;
            }
            if (event.text == Key.RightArrow || event.text == Key.PageDown) {
                root.turn-page(true);
                return accept;
            }
            reject
        }

        VerticalLayout {
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 6px;
                spacing: 8px;
                height: 30px;
                Text {
                    text: mode == Mode.list ? root.workspace : "Rado";
                    horizontal-stretch: 1;
                    font-size: 10px;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if mode == Mode.list: Text {
                    text: root.updated;
                    font-family: "JetBrains Mono";
                    font-size: 8px;
                    color: #444;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    Button {
                        text: "Exit";
                        clicked => { root.exit(); }
                    }
                }
            }

            if mode == Mode.setup: VerticalLayout {
                padding: 16px;
                spacing: 12px;
                alignment: start;
                Text {
                    text: "Pair with Rado";
                    font-size: 14px;
                    font-weight: 700;
                }
                Text {
                    text: root.message;
                    font-size: 10px;
                    wrap: word-wrap;
                }
                Text {
                    text: "In Rado on the laptop, open Settings > General > PocketBook, press Copy config, and save the text as " + root.config-path + ". Then start this app again.";
                    font-size: 10px;
                    wrap: word-wrap;
                }
            }

            if mode == Mode.waiting: VerticalLayout {
                padding: 16px;
                alignment: start;
                Text {
                    text: root.message;
                    font-size: 10px;
                    wrap: word-wrap;
                }
            }

            if mode == Mode.list: VerticalLayout {
                for banner in root.banners: Rectangle {
                    height: 18px;
                    background: black;
                    Text {
                        text: banner;
                        color: white;
                        font-size: 9px;
                        font-weight: 700;
                        overflow: elide;
                        x: 10px;
                        width: parent.width - 20px;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    height: 112px;
                    VerticalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 4px;
                        HorizontalLayout {
                            spacing: 18px;
                            alignment: start;
                            VerticalLayout {
                                Text {
                                    text: root.reviews;
                                    font-family: "JetBrains Mono";
                                    font-size: 56px;
                                    font-weight: 800;
                                }
                                Text {
                                    text: root.reviews == 1 ? "review" : "reviews";
                                    font-size: 9px;
                                    color: #444;
                                }
                            }
                            VerticalLayout {
                                alignment: end;
                                Text {
                                    text: root.mine;
                                    font-family: "JetBrains Mono";
                                    font-size: 30px;
                                    font-weight: 700;
                                }
                                Text {
                                    text: "yours";
                                    font-size: 9px;
                                    color: #444;
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: root.summary;
                                font-size: 12px;
                                font-weight: 800;
                                vertical-alignment: center;
                            }
                            if root.has-new: Text {
                                text: "tap to mark seen";
                                font-size: 8px;
                                color: #555;
                                vertical-alignment: center;
                            }
                        }
                    }
                    TouchArea {
                        clicked => { root.acknowledge(); }
                    }
                }
                Rectangle {
                    height: 2px;
                    background: black;
                }
                VerticalLayout {
                    alignment: start;
                    vertical-stretch: 1;
                    for item in root.items: ItemLine { item: item; }
                }
                if root.pages > 1: HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    height: 28px;
                    VerticalLayout {
                        alignment: center;
                        Button {
                            text: "‹";
                            enabled: root.page > 1;
                            clicked => { root.turn-page(false); }
                        }
                    }
                    Text {
                        text: root.page + " / " + root.pages;
                        horizontal-stretch: 1;
                        font-family: "JetBrains Mono";
                        font-size: 9px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    VerticalLayout {
                        alignment: center;
                        Button {
                            text: "›";
                            enabled: root.page < root.pages;
                            clicked => { root.turn-page(true); }
                        }
                    }
                }
            }
        }
    }
}
