// Sizes are logical pixels: on the Era Color one is 3.48 physical pixels (300 dpi times its 1.16 scale), so the
// screen is about 363 by 483. The look is the list window's card design, on paper: grey cards on white, pills for
// facts and chips, and colour only in the tier pill.
import "fonts/AtkinsonHyperlegibleNext.ttf";
import "fonts/JetBrainsMono.ttf";
import { Palette } from "std-widgets.slint";

export struct TabItem {
    label: string,
    count: int,
    selected: bool,
    next: bool,
}

export enum Tier { low, normal, urgent }

export enum FactKind { plain, pill, approved, objected }

export struct FactItem {
    text: string,
    kind: FactKind,
}

export struct RowItem {
    title: string,
    tier: Tier,
    review-next: bool,
    facts: [FactItem],
    draft-ready: bool,
    /// Empty when the row names no ticket.
    ticket: string,
    prs: [string],
}

export enum Mode { setup, waiting, list }

component Pill inherits Rectangle {
    in property <string> text;
    in property <color> fill: white;
    in property <color> ink: black;
    in property <bool> bold;
    height: 13px;
    border-radius: 6.5px;
    background: fill;
    HorizontalLayout {
        padding-left: 5px;
        padding-right: 5px;
        Text {
            text: root.text;
            color: root.ink;
            font-size: 8px;
            font-weight: root.bold ? 700 : 500;
            vertical-alignment: center;
        }
    }
}

component Button inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    min-width: 40px;
    height: 22px;
    border-radius: 11px;
    border-width: 1px;
    border-color: enabled ? black : #aaa;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.text;
            color: root.enabled ? black : #aaa;
            font-size: 9px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
    TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Kaleido colour is faint, so the fills are dark and saturated and the word alone says the tier.
component TierPill inherits Rectangle {
    in property <Tier> tier;
    width: 42px;
    height: 14px;
    border-radius: 7px;
    border-width: 1px;
    border-color: tier == Tier.low ? black : transparent;
    background: tier == Tier.urgent ? #a0001c : tier == Tier.normal ? #1b3f8b : white;
    Text {
        text: tier == Tier.urgent ? "Urgent" : tier == Tier.normal ? "Normal" : "Low";
        color: tier == Tier.low ? black : white;
        font-size: 8px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component Card inherits Rectangle {
    in property <RowItem> item;
    height: 52px;
    border-radius: 10px;
    background: item.review-next ? #d4d4d4 : #ececec;
    clip: true;
    VerticalLayout {
        padding-top: 4px;
        padding-bottom: 4px;
        padding-left: 8px;
        padding-right: 6px;
        spacing: 2px;
        HorizontalLayout {
            height: 14px;
            spacing: 6px;
            Text {
                text: item.title;
                horizontal-stretch: 1;
                font-size: 10px;
                font-weight: 700;
                vertical-alignment: center;
                overflow: elide;
            }
            TierPill { tier: item.tier; }
        }
        HorizontalLayout {
            alignment: start;
            spacing: 3px;
            if item.review-next: Pill {
                text: "Review next";
                fill: black;
                ink: white;
                bold: true;
            }
            for fact in item.facts: Pill {
                text: fact.text;
                fill: fact.kind == FactKind.plain ? transparent : fact.kind == FactKind.objected ? #4a4a4a : white;
                ink: fact.kind == FactKind.objected ? white : black;
                bold: fact.kind == FactKind.approved || fact.kind == FactKind.objected;
            }
            if item.draft-ready: Pill {
                text: "Draft ready";
                fill: black;
                ink: white;
                bold: true;
            }
        }
        HorizontalLayout {
            alignment: start;
            spacing: 3px;
            if item.ticket != "": Pill {
                text: item.ticket;
                fill: #b8b8b8;
                bold: true;
            }
            for pr in item.prs: Pill { text: pr; }
        }
    }
}

export component AppWindow inherits Window {
    in property <Mode> mode;
    /// The setup problem, or what the app is doing before the first list.
    in property <string> message;
    in property <string> config-path;
    in property <string> workspace;
    in property <int> reviews;
    in property <int> mine;
    in property <string> updated;
    in property <[string]> banners;
    in property <[TabItem]> tabs;
    in property <[RowItem]> rows;
    in property <string> page;
    in property <bool> has-previous;
    in property <bool> has-next;
    /// "That's all 9", under the last card when its page has room; empty otherwise.
    in property <string> end;
    callback select-tab(int);
    callback turn-page(bool);
    callback exit();

    preferred-width: 363px;
    preferred-height: 483px;
    background: white;
    default-font-family: "Atkinson Hyperlegible Next";

    // Text defaults to the palette's colour, which a desktop in dark mode makes white.
    init => { Palette.color-scheme = ColorScheme.light; }

    forward-focus: keys;
    // The page buttons arrive as Left and Right (inkview-slint's mapping of Prev and Next).
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.LeftArrow || event.text == Key.PageUp) {
                root.turn-page(false);
                return accept;
            }
            if (event.text == Key.RightArrow || event.text == Key.PageDown) {
                root.turn-page(true);
                return accept;
            }
            reject
        }

        VerticalLayout {
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 6px;
                spacing: 8px;
                height: 34px;
                Text {
                    text: mode == Mode.list ? root.workspace : "Rado";
                    horizontal-stretch: 1;
                    font-size: 12px;
                    font-weight: 800;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if mode == Mode.list: Text {
                    text: root.reviews + " reviews · " + root.mine + " mine";
                    font-family: "JetBrains Mono";
                    font-size: 9px;
                    vertical-alignment: center;
                }
                if mode == Mode.list: Text {
                    text: root.updated;
                    font-family: "JetBrains Mono";
                    font-size: 8px;
                    color: #444;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    Button {
                        text: "Exit";
                        clicked => { root.exit(); }
                    }
                }
            }

            if mode == Mode.setup: VerticalLayout {
                padding: 16px;
                spacing: 12px;
                alignment: start;
                Text {
                    text: "Pair with Rado";
                    font-size: 14px;
                    font-weight: 700;
                }
                Text {
                    text: root.message;
                    font-size: 10px;
                    wrap: word-wrap;
                }
                Text {
                    text: "In Rado on the laptop, open Settings > General > PocketBook, press Copy config, and save the text as " + root.config-path + ". Then start this app again.";
                    font-size: 10px;
                    wrap: word-wrap;
                }
            }

            if mode == Mode.waiting: VerticalLayout {
                padding: 16px;
                alignment: start;
                Text {
                    text: root.message;
                    font-size: 10px;
                    wrap: word-wrap;
                }
            }

            if mode == Mode.list: VerticalLayout {
                for banner in root.banners: Rectangle {
                    height: 18px;
                    background: black;
                    Text {
                        text: banner;
                        color: white;
                        font-size: 9px;
                        overflow: elide;
                        x: 8px;
                        width: parent.width - 16px;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    padding: 4px;
                    spacing: 4px;
                    height: 30px;
                    for tab[index] in root.tabs: Rectangle {
                        border-radius: 11px;
                        background: tab.selected ? black : #ececec;
                        HorizontalLayout {
                            alignment: center;
                            spacing: 4px;
                            Text {
                                text: tab.label;
                                color: tab.selected ? white : black;
                                font-size: 9px;
                                font-weight: tab.selected ? 700 : 500;
                                vertical-alignment: center;
                            }
                            Text {
                                text: tab.count + (tab.next ? " •" : "");
                                color: tab.selected ? white : #444;
                                font-family: "JetBrains Mono";
                                font-size: 9px;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea {
                            clicked => { root.select-tab(index); }
                        }
                    }
                }
                VerticalLayout {
                    alignment: start;
                    vertical-stretch: 1;
                    padding-left: 4px;
                    padding-right: 4px;
                    spacing: 4px;
                    for row in root.rows: Card { item: row; }
                    if root.rows.length == 0: Text {
                        text: "Nothing here.";
                        font-size: 10px;
                        horizontal-alignment: center;
                        height: 48px;
                        vertical-alignment: center;
                    }
                    if root.end != "": Text {
                        text: root.end;
                        font-size: 10px;
                        font-weight: 800;
                        color: #666;
                        horizontal-alignment: center;
                        height: 30px;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    height: 32px;
                    VerticalLayout {
                        alignment: center;
                        Button {
                            text: "‹ Back";
                            enabled: root.has-previous;
                            clicked => { root.turn-page(false); }
                        }
                    }
                    Text {
                        text: root.page;
                        horizontal-stretch: 1;
                        font-family: "JetBrains Mono";
                        font-size: 9px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    VerticalLayout {
                        alignment: center;
                        Button {
                            text: "Next ›";
                            enabled: root.has-next;
                            clicked => { root.turn-page(true); }
                        }
                    }
                }
            }
        }
    }
}
